<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>1.0.3</Version>
		<Authors>Matt Gordon</Authors>
		<Company>Matt Gordon</Company>
		<Description>Binds Kendo UI grid requests (paging, sorting, filtering, grouping, aggregates) to IQueryable data in ASP.NET Core MVC and Web API applications.</Description>
		<PackageTags>kendo-ui;kendo-grid;aspnetcore;mvc;model-binder;linq;dynamic-linq;automapper</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/gordon-matt/Extenso</PackageProjectUrl>
		<RepositoryUrl>https://github.com/gordon-matt/Extenso</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>ExtensoIcon.jpg</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\_Misc\ExtensoIcon.jpg">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AutoMapper" Version="14.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.4" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="README.md">
	    <PackagePath>\</PackagePath>
	    <Pack>True</Pack>
	  </None>
	</ItemGroup>

</Project>